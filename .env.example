# Copy this file to .env and fill in secrets for local development
# Do NOT commit the .env file.

# Gemini API key (replace with your local key)
GEMINI_API_KEY=

# Optional: Firestore database name (defaults to 'portfolio')
FIRESTORE_DATABASE=portfolio

# Optional: Path to Google application credentials file for Firestore
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Optional: Local debug flags
# DEBUG=true
